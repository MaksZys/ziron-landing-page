{
  "name": "ziron-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "content:unsplash": "node --env-file=.env scripts/sync-unsplash.mjs",
    "dev": "vite",
    "build": "npm run locales:sync && npm run typecheck && vite build",
    "locales:extract": "lit-localize extract",
    "locales:generate": "node scripts/generate-translations.mjs",
    "locales:compile": "lit-localize build",
    "locales:sync": "npm run locales:extract && npm run locales:generate && npm run locales:compile",
    "test:translations": "node --test scripts/generate-translations.test.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@lit/localize-tools": "^0.8.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "daisyui": "^5.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0"
  }
}
