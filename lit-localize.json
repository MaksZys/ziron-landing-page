{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["pl", "de"],
  "tsConfig": "./tsconfig.json",
  "interchange": {
    "format": "xliff",
    "xliffDir": "./translations/xliff"
  },
  "output": {
    "mode": "runtime",
    "outputDir": "./src/generated/locales",
    "localeCodesModule": "./src/generated/locales/locale-codes.ts"
  }
}
