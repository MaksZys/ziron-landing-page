        <source>AS TWO</source>
        <target>ZU ZWEIT</target>
      </trans-unit>
      <trans-unit id="about.heroSummary">
        <source>Film. Photography. Movement. From idea to finished material — we lead the entire process.</source>
        <target>Film. Fotografie. Bewegung. Von der Idee bis zum fertigen Material — wir begleiten den gesamten Prozess.</target>
      </trans-unit>
      <trans-unit id="about.heroIndex">
        <source>ABOUT / 01</source>
        <target>ÜBER UNS / 01</target>
      </trans-unit>
      <trans-unit id="about.heroImageAlt">
        <source>Two men standing together on a rooftop at sunset</source>
        <target>Zwei Männer stehen gemeinsam auf einem Dach bei Sonnenuntergang</target>
      </trans-unit>
      <trans-unit id="about.heroCaption">
        <source>PRODUCTION / MOTION</source>
        <target>PRODUKTION / BEWEGUNG</target>
      </trans-unit>
