      <trans-unit id="about.heroEyebrow">
        <source>ZIRON / WHO WE ARE</source>
        <target>ZIRON / KIM JESTEŚMY</target>
      </trans-unit>
      <trans-unit id="about.heroTitleFirst">
        <source>WE CREATE</source>
        <target>TWORZYMY</target>
      </trans-unit>
      <trans-unit id="about.heroTitleSecond">
        <source>AS TWO</source>
        <target>WE DWOJE</target>
      </trans-unit>
      <trans-unit id="about.heroSummary">
        <source>Film. Photography. Movement. From idea to finished material — we lead the entire process.</source>
        <target>Film. Fotografia. Ruch. Od pomysłu do gotowego materiału — prowadzimy cały proces.</target>
      </trans-unit>
      <trans-unit id="about.heroIndex">
        <source>ABOUT / 01</source>
        <target>O NAS / 01</target>
      </trans-unit>
      <trans-unit id="about.heroImageAlt">
        <source>Two men standing together on a rooftop at sunset</source>
        <target>Dwóch mężczyzn stojących razem na dachu o zachodzie słońca</target>
      </trans-unit>
      <trans-unit id="about.heroCaption">
        <source>PRODUCTION / MOTION</source>
        <target>PRODUKCJA / RUCH</target>
      </trans-unit>
      <trans-unit id="about.teamEyebrow">
        <source>02 / TEAM</source>
        <target>02 / ZESPÓŁ</target>
      </trans-unit>
      <trans-unit id="about.teamTitleFirst">
        <source>TWO POINTS</source>
        <target>DWA PUNKTY</target>
      </trans-unit>
      <trans-unit id="about.teamTitleSecond">
        <source>OF VIEW.</source>
        <target>WIDZENIA.</target>
      </trans-unit>
      <trans-unit id="about.teamSummary">
        <source>Our shared work and similar approach to creating images brought us together. Our skills complement each other, but we take responsibility for every project together.</source>
        <target>Połączyła nas wspólna praca i podobne podejście do tworzenia obrazów. Uzupełniamy się umiejętnościami, ale za każdą realizację odpowiadamy razem.</target>
      </trans-unit>
      <trans-unit id="about.kuleszaRole">
        <source>Film / photography / editing</source>
        <target>Film / fotografia / montaż</target>
      </trans-unit>
      <trans-unit id="about.kuleszaImageAlt">
        <source>Mateusz Kulesza, ZIRON team member</source>
        <target>Mateusz Kulesza, członek zespołu ZIRON</target>
      </trans-unit>
      <trans-unit id="about.radkenRole">
        <source>Film / drone / post-production</source>
        <target>Film / dron / postprodukcja</target>
