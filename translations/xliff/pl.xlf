      <trans-unit id="about.methodEyebrow">
        <source>03 / HOW WE WORK</source>
        <target>03 / SPOSÓB PRACY</target>
      </trans-unit>
      <trans-unit id="about.methodTitleFirst">
        <source>WE DO MORE THAN</source>
        <target>NIE TYLKO</target>
      </trans-unit>
      <trans-unit id="about.methodTitleSecond">
        <source>RECORD.</source>
        <target>REJESTRUJEMY.</target>
      </trans-unit>
      <trans-unit id="about.methodSummary">
        <source>We started out as amateurs, driven by a passion for filming and telling stories through images. Today, we create professional materials for companies in technical and industrial sectors and wherever real work matters.</source>
        <target>Zaczynaliśmy amatorsko, z pasji do nagrywania i opowiadania historii obrazem. Dziś tworzymy profesjonalne materiały dla firm z branż technicznych, przemysłowych i wszędzie tam, gdzie liczy się prawdziwa praca.</target>
      </trans-unit>
      <trans-unit id="about.methodExpertise">
        <source>Industry expertise</source>
        <target>Znajomość branży</target>
      </trans-unit>
      <trans-unit id="about.methodProduction">
        <source>Full production process</source>
        <target>Pełny proces produkcji</target>
      </trans-unit>
      <trans-unit id="about.methodQuality">
        <source>Quality without shortcuts</source>
        <target>Jakość bez skrótów</target>
      </trans-unit>
