      <trans-unit id="privacy.general.heading">
        <source>1. General information</source>
        <target>1. Informacje ogólne</target>
      </trans-unit>
      <trans-unit id="privacy.general.brand">
        <source>ZIRON</source>
        <target>ZIRON</target>
      </trans-unit>
      <trans-unit id="privacy.general.controller">
        <source>is the controller of personal data and provides mobile washing services for machinery, vehicles and equipment.</source>
        <target>jest administratorem danych osobowych i firmą świadczącą usługi mobilnego mycia maszyn, pojazdów i sprzętu.</target>
      </trans-unit>
      <trans-unit id="privacy.general.contact">
        <source>You can contact the controller using the contact form or the telephone number shown in advertisements.</source>
        <target>Kontakt z administratorem danych możliwy jest za pośrednictwem formularza kontaktowego lub numeru telefonu podanego w reklamach.</target>
      </trans-unit>
      <trans-unit id="privacy.scope.heading">
        <source>2. Scope of collected data</source>
        <target>2. Zakres zbieranych danych</target>
      </trans-unit>
      <trans-unit id="privacy.scope.summary">
        <source>The following data may be collected through Meta (Facebook / Instagram) advertising forms:</source>
        <target>Za pośrednictwem formularzy reklamowych Meta (Facebook / Instagram) zbierane mogą być następujące dane:</target>
      </trans-unit>
      <trans-unit id="privacy.scope.name">
        <source>first and last name,</source>
        <target>imię i nazwisko,</target>
      </trans-unit>
      <trans-unit id="privacy.scope.phone">
        <source>telephone number,</source>
        <target>numer telefonu,</target>
      </trans-unit>
      <trans-unit id="privacy.scope.email">
        <source>email address,</source>
        <target>adres e-mail,</target>
      </trans-unit>
      <trans-unit id="privacy.scope.other">
        <source>other information voluntarily provided in the submission.</source>
        <target>inne informacje dobrowolnie podane w treści zgłoszenia.</target>
      </trans-unit>
